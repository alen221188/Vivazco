{
  "1": {
    "inputs": {
      "image": "[inputs/products/seu_produto.jpg]",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "🖼️ Carregar Imagem do Produto",
      "description": "Carrega a imagem do produto (com ou sem background)"
    }
  },
  "2": {
    "inputs": {
      "samples": [
        "1",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "Decodificar Imagem",
      "description": "Prepara imagem para processamento"
    }
  },
  "3": {
    "inputs": {
      "image": [
        "1",
        0
      ]
    },
    "class_type": "ImageScale",
    "_meta": {
      "title": "Escalar Imagem",
      "description": "Redimensiona para resolução padrão se necessário",
      "width": 1024,
      "height": 1024,
      "upscale_method": "lanczos"
    }
  },
  "4": {
    "inputs": {
      "text": "a luxury bathroom with [PRODUCT_TYPE], sophisticated lighting, marble countertops, premium fixtures, professional photography, cinematic lighting, 8k quality, hyperrealistic, trending on artstation"
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "✍️ Prompt Positivo",
      "description": "Descrição do ambiente luxuoso e produto"
    }
  },
  "5": {
    "inputs": {
      "text": "blur, distortion, low quality, artifact, watermark, text, bad proportions, incorrect dimensions"
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "❌ Prompt Negativo",
      "description": "O que evitar na geração"
    }
  },
  "6": {
    "inputs": {
      "seed": 42,
      "steps": 30,
      "cfg": 7.5,
      "sampler_name": "dpmpp_2m_sde_karras",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["sdxl_turbo"],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["3", 0]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "🎨 Sampler - Geração Principal",
      "description": "Gera a imagem do ambiente com o produto",
      "note": "SDXL-Turbo para velocidade. Ajustar seed para variações."
    }
  },
  "7": {
    "inputs": {
      "samples": [
        "6",
        0
      ],
      "vae": ["vae_model"]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "🖼️ Decodificar Resultado",
      "description": "Converte latent para imagem final"
    }
  },
  "8": {
    "inputs": {
      "images": [
        "7",
        0
      ],
      "upscale_method": "lanczos",
      "width": 1080,
      "height": 1080,
      "crop": "center"
    },
    "class_type": "ImageScale",
    "_meta": {
      "title": "📐 Escalar para E-commerce",
      "description": "Redimensiona para padrão de e-commerce (1080x1080)"
