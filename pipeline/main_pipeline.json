  "_metadata": {
    "title": "🚀 Vivazco - Bathroom Fixtures Pipeline",
    "version": "1.0.0",
    "description": "Pipeline completo para gerar renderizações de louças de banheiro em ambientes luxuosos",
    "author": "Claude Code",
    "date": "2026-09-30",
    "models_required": [
      "SDXL-Turbo (ou SDXL)",
      "VAE (opcional, para melhor qualidade)"
    ],
    "usage": {
      "step_1": "Coloque imagem do produto em inputs/products/",
      "step_2": "Edite o node 1 com o caminho da imagem",
      "step_3": "Ajuste os prompts (nodes 4, 10, 15, 20) conforme necessário",
      "step_4": "Clique 'Queue Prompt' para executar",
      "step_5": "Resultados estarão em outputs/ecommerce/"
    },
    "optimization_tips": [
      "Use SDXL-Turbo para velocidade (2-3 min)",
      "Aumente steps para 50+ se usar SDXL normal",
      "Reduza CFG a 6-7 para menos efeitos IA",
      "Ajuste seeds para diferentes variações",
      "Teste diferentes samplers (dpmpp, euler, heun)"
    ],
    "performance": {
      "gpu_minimum": "12GB VRAM",
      "estimated_time": "2-3 minutos (SDXL-Turbo)",
      "output_quality": "1080x1080px, JPEG 85%"
    }
  },
  "notes": {
    "preservacao_produto": "O produto original não sofre nenhuma alteração. Todas as características, cores e dimensões são preservadas.",
    "realismo": "Evite aumentar CFG muito (pode parecer IA forçado). Prefira 6-8 para aspecto natural.",
    "variacoes": "Cada seed gera uma variação diferente. Ajuste seeds para criar ângulos e iluminações diferentes.",
    "ecommerce": "Todas as saídas são otimizadas para 1080x1080px com compressão JPEG 85% (ótima qualidade/tamanho)",
    "customizacao": "Edite os prompts para adaptar ao seu estilo/marca preferido"
  }
}
